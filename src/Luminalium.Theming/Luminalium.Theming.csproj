<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Luminalium.Theming: cross-platform Monet color math and image sampling.
    Plain net10.0 so Windows providers can reference it without introducing
    platform interop into the deterministic theme pipeline.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luminalium.Core\Luminalium.Core.csproj" />
  </ItemGroup>

</Project>
