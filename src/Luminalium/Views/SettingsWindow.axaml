<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                       xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                       xmlns:views="clr-namespace:Luminalium.Views"
                       xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core"
                       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                       MinWidth="600" MinHeight="400"
                       x:Class="Luminalium.Views.SettingsWindow"
                       x:DataType="views:SettingsWindow"
                       Icon="/Assets/logo.ico"
                       Title="Luminalium">
    <Grid RowDefinitions="Auto *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto * Auto" Height="48"
              Background="Transparent"
              WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16 8 8 8" Spacing="8">
                <Image Source="/Assets/logo.ico" Height="18" />
                <TextBlock VerticalAlignment="Center">Luminalium</TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8" Spacing="8">
                <Button Classes="accent"
                        Margin="0 -8" VerticalAlignment="Center"
                        IsVisible="{Binding ViewModel.IsRequestedRestart}"
                        ToolTip.Tip="部分设置需要重启才能生效，点击以重启应用"
                        Click="ButtonRestartApp_OnClick"
                        WindowDecorationProperties.ElementRole="User">
                    <lumn:IconText Glyph="{lumn:Fi ArrowCounterclockwiseFilled}"
                                   Text="需要重启" />
                </Button>
                
                <Border Width="140" IsVisible="{x:Static lumn:App.IsWindows}" />
            </StackPanel>
        </Grid>

        <fa:FANavigationView Grid.Row="1"
                             x:Name="NavigationView"
                             PaneDisplayMode="Left"
                             IsSettingsVisible="False"
                             MenuItemsSource="{Binding ViewModel.NavigationViewItems, Mode=OneWay}"
                             FooterMenuItemsSource="{Binding ViewModel.NavigationViewFooterItems, Mode=OneWay}"
                             SelectedItem="{Binding ViewModel.SelectedNavigationViewItem, UpdateSourceTrigger=PropertyChanged}"
                             ItemInvoked="NavigationView_OnItemInvoked">
            <fa:FANavigationView.AutoCompleteBox>
                <AutoCompleteBox PlaceholderText="搜索..." />
            </fa:FANavigationView.AutoCompleteBox>
            
            <lumn:DrawerHost IsDrawerOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
                             DrawerPlacement="Right"
                             DrawerContent="{Binding ViewModel.DrawerContent}">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" Margin="12 16 18 0"
                          IsVisible="{Binding !ViewModel.SelectedPageInfo.HidePageTitle}"
                          Classes.FullWidth="{Binding ViewModel.SelectedPageInfo.UseFullWidth}"
                          x:Name="TitleContainer">
                        <Grid.Styles>
                            <Style Selector="Grid#TitleContainer:not(.FullWidth)">
                                <Setter Property="MaxWidth" Value="{StaticResource PageContainerWidth}" />
                            </Style>
                        </Grid.Styles>

                        <TextBlock FontWeight="Normal"
                                   Text="{Binding ViewModel.SelectedPageInfo.Name}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                    </Grid>

                    <fa:FAFrame Grid.Row="1"
                                x:Name="NavigationFrame"
                                IsNavigationStackEnabled="False" CacheSize="0"
                                Content="{Binding ViewModel.FrameContent}" />
                </Grid>
            </lumn:DrawerHost>
        </fa:FANavigationView>
    </Grid>
</windowing:FAAppWindow>