<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.StatusBarSettingsPage" x:DataType="cfg:MainConfigModel"><ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi PanelBottomRegular}" Text="状态栏" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi PanelBottomRegular}}" Header="显示状态栏" Description="在 Overlay 顶部显示状态栏，展示时间、电量等信息。"><fa:FASettingsExpander.Footer><ToggleSwitch IsChecked="{Binding ShowStatusBar}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi StatusRegular}}" Header="状态栏项目"><fa:FASettingsExpanderItem Content="显示时间"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowStatusTime}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="显示秒"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowStatusSeconds}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="显示电量"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowStatusBattery}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="显示音量"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowStatusVolume}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="显示网络"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowStatusNetwork}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="显示音乐"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowStatusMusic}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander></StackPanel></ScrollViewer></UserControl>
