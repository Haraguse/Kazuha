<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.FontSettingsPage" x:DataType="cfg:MainConfigModel">
 <ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi TextFontRegular}" Text="字体" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi TextFontRegular}}" Header="启用自定义字体" Description="开启后可指定软件界面使用的字体，并为不同语言单独覆盖。"><fa:FASettingsExpander.Footer><ToggleSwitch IsChecked="{Binding CustomFont}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi FontSpaceTrackingInRegular}}" Header="字体选择" Description="选择全局字体、字重和预览文本。"><fa:FASettingsExpanderItem Content="字体"><fa:FASettingsExpanderItem.Footer><TextBox Width="220" Text="{Binding FontFamily}" IsEnabled="{Binding CustomFont}" PlaceholderText="系统默认"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="字重"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding FontWeight}" IsEnabled="{Binding CustomFont}"><ComboBoxItem Content="常规"/><ComboBoxItem Content="中等"/><ComboBoxItem Content="粗体"/><ComboBoxItem Content="细体"/><ComboBoxItem Content="半粗"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="预览文本"><fa:FASettingsExpanderItem.Footer><TextBox Width="260" Text="{Binding PreviewSample}" IsEnabled="{Binding CustomFont}" PlaceholderText="Luminalium / 荧素万演"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi LocalLanguageRegular}}" Header="按语言覆盖字体" Description="未指定的语言使用全局字体。"><fa:FASettingsExpanderItem Content="简体中文 / 繁體中文 / 粤语"><fa:FASettingsExpanderItem.Footer><TextBox Width="180" Text="{Binding LanguageFontOverrides}" IsEnabled="{Binding CustomFont}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="日本語 / English / 维吾尔语"><fa:FASettingsExpanderItem.Footer><TextBlock Text="使用全局字体，或在配置中分别指定。" Opacity="0.65"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander></StackPanel></ScrollViewer>
</UserControl>
