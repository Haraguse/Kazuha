<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core"
             xmlns:cfg="using:Luminalium.Models.Config"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="600"
             x:Class="Luminalium.Views.SettingsPages.GeneralSettingsPage"
             x:DataType="cfg:MainConfigModel">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro" Spacing="4">
            <StackPanel Spacing="10">
                <Border Padding="18"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource AccentControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="界面语言" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="更改语言后需重启软件才能在所有界面生效。"
                                       TextWrapping="Wrap"
                                       Opacity="0.65"
                                       FontSize="12" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LanguageOptions}"
                                 SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                                 HorizontalAlignment="Left"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Theme="{StaticResource ChipListBoxTheme}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <lumn:IconText Glyph="{lumn:Fi SettingsRegular}" Text="行为" Margin="0,12,0,4" />

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi PowerRegular}}"
                                   Header="开机自启"
                                   Description="在系统登录后自动启动 Luminalium，仅对当前用户生效。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi LinkRegular}}"
                                   Header="注册 URL 协议"
                                   Description="允许第三方应用通过 luminalium:// 链接打开设置、计时器和画板等功能。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding RegisterUrlProtocol, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi PanelLeftRegular}}"
                                   Header="自动显示 Overlay"
                                   Description="检测到幻灯片放映时自动打开 Overlay。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AutoShowOverlay, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi SlideTextRegular}}"
                                   Header="禁用界面动画"
                                   Description="关闭全局过渡、缩放与滚动动画，界面会直接切换到最终状态。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding DisableAnimations, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ShieldKeyholeRegular}}"
                                   Header="异常退出处理"
                                   Description="程序未捕获异常时，自动打开详情、后台重启、发送通知或直接退出。">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox Width="150" SelectedIndex="{Binding CrashHandlerMode, Mode=TwoWay}">
                            <ComboBoxItem Content="打开崩溃详情" />
                            <ComboBoxItem Content="直接退出" />
                            <ComboBoxItem Content="静默重启" />
                            <ComboBoxItem Content="发送通知" />
                        </ComboBox>
                        <ToggleSwitch IsChecked="{Binding CrashHandlerEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ArrowSortUpRegular}}"
                                   Header="翻页频率上限"
                                   Description="限制每秒最多受理的翻页请求次数，超出的点击会被忽略。">
                <fa:FASettingsExpander.Footer>
                    <lumn:Field Suffix="次/秒" VerticalAlignment="Center">
                        <NumericUpDown MinWidth="110"
                                       Minimum="1"
                                       Maximum="10"
                                       FormatString="0"
                                       Value="{Binding PageRateLimit, Mode=TwoWay}" />
                    </lumn:Field>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0,12,0,4" />
            <lumn:IconText Glyph="{lumn:Fi ShieldRegular}" Text="安全与兼容性" Margin="0,0,0,4" />

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi LockClosedRegular}}"
                                   Header="设置密码保护"
                                   Description="启用后打开设置需要输入密码。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding PasswordProtectionEnabled, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi SettingsRegular}}"
                                   Header="兼容模式"
                                   Description="让悬浮窗常驻显示，翻页改用兼容输入，并关闭部分自动显隐功能。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding CompatibilityMode, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi WindowRegular}}"
                                   Header="使用原生标题栏"
                                   Description="使用操作系统提供的标题栏和窗口按钮。">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding UseNativeTitleBar, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
