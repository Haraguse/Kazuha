<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.BuiltInSettingsPage" x:DataType="cfg:MainConfigModel"><ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi AppsRegular}" Text="内建功能" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi BoardRegular}}" Header="板中板" Description="配置小画板的位置、颜色和擦除行为。"><fa:FASettingsExpanderItem Content="窗口位置"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding BoardWindowPosition}"><ComboBoxItem Content="右下"/><ComboBoxItem Content="右上"/><ComboBoxItem Content="左下"/><ComboBoxItem Content="左上"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="背景颜色"><fa:FASettingsExpanderItem.Footer><TextBox Width="130" Text="{Binding BoardBackgroundColor}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="橡皮擦模式"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding BoardEraserMode}"><ComboBoxItem Content="点选"/><ComboBoxItem Content="笔画"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="笔迹效果"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding BoardPenEffect}"><ComboBoxItem Content="关闭"/><ComboBoxItem Content="有限"/><ComboBoxItem Content="完整"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="进入动画"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding BoardWindowEnterAnimation}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi TimerRegular}}" Header="计时器" Description="配置计时器全屏行为、音效和快捷加时。"><fa:FASettingsExpanderItem Content="全屏行为"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding TimerFullscreenBehavior}"><ComboBoxItem Content="普通"/><ComboBoxItem Content="最大化"/><ComboBoxItem Content="全屏"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="启用音效"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding TimerSoundEffects}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="快捷加时预设（分钟）"><fa:FASettingsExpanderItem.Footer><TextBox Width="220" Text="{Binding TimerQuickAddPresets}" PlaceholderText="1, 5, 10"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander></StackPanel></ScrollViewer></UserControl>
