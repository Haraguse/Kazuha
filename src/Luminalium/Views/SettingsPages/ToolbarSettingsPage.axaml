<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.ToolbarSettingsPage" x:DataType="cfg:MainConfigModel">
 <ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi ToolboxRegular}" Text="工具栏" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ToolboxRegular}}" Header="工具栏显示" Description="控制 Overlay 工具栏是否显示文字和提示。"><fa:FASettingsExpanderItem Content="显示工具文字"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowToolbarText}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="显示工具提示"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowTooltips}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi TransparencySquareRegular}}" Header="清屏和透明度" Description="选择清屏动效并调整工具栏透明度。"><fa:FASettingsExpanderItem Content="清屏方式"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding ClearMode}"><ComboBoxItem Content="上滑清除"/><ComboBoxItem Content="按钮清除"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="工具栏不透明度"><fa:FASettingsExpanderItem.Footer><Slider Width="180" Minimum="0.1" Maximum="1" Value="{Binding ToolbarOpacity}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="同步不透明度"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding SyncOpacity}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi EyeOffRegular}}" Header="工具可用性" Description="关闭的工具将从 Overlay 工具栏中隐藏。"><fa:FASettingsExpanderItem Content="清除"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowClear}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="聚光灯"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowSpotlight}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="板中板"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowBoard}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="计时器"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowTimer}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ReOrderRegular}}" Header="工具顺序" Description="按逗号分隔调整工具排列顺序。"><fa:FASettingsExpander.Footer><TextBox Width="320" Text="{Binding ToolbarOrder}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi AppsListRegular}}" Header="快速启动应用" Description="输入可快速启动的应用路径，每行一个。"><fa:FASettingsExpander.Footer><TextBox Width="320" AcceptsReturn="True" Text="{Binding QuickLaunchApps}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander></StackPanel></ScrollViewer>
</UserControl>
