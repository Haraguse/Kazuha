<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.NotificationSettingsPage" x:DataType="cfg:MainConfigModel"><ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi AlertRegular}" Text="通知" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi GaugeRegular}}" Header="资源监视" Description="每隔指定时间刷新 CPU 与内存占用显示；0 表示关闭资源监视。"><fa:FASettingsExpander.Footer><ComboBox Width="170" SelectedIndex="{Binding ResourceMonitorIntervalIndex}"><ComboBoxItem Content="关闭 (0 秒)"/><ComboBoxItem Content="30 秒"/><ComboBoxItem Content="1 分钟"/><ComboBoxItem Content="5 分钟"/><ComboBoxItem Content="10 分钟"/><ComboBoxItem Content="30 分钟"/><ComboBoxItem Content="45 分钟"/><ComboBoxItem Content="60 分钟"/></ComboBox></fa:FASettingsExpander.Footer></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi TimerRegular}}" Header="定时器到点通知" Description="倒计时结束时发送系统通知提醒。"><fa:FASettingsExpander.Footer><ToggleSwitch IsChecked="{Binding TimerNotifyEnabled}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander></StackPanel></ScrollViewer></UserControl>
