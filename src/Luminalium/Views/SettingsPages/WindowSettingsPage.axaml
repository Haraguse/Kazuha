<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.WindowSettingsPage" x:DataType="cfg:MainConfigModel">
  <ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4">
    <lumn:IconText Glyph="{lumn:Fi WindowRegular}" Text="显示与位置" Margin="0,0,0,4"/>
    <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi WindowRegular}}" Header="Overlay 显示与位置" Description="配置 Overlay 所在屏幕、工具栏位置和缩放。">
      <fa:FASettingsExpanderItem Content="显示屏幕"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding OverlayScreenIndex}"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Primary"/><ComboBoxItem Content="Screen1"/><ComboBoxItem Content="Screen2"/><ComboBoxItem Content="Screen3"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="工具栏位置"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding ToolbarPosition}"><ComboBoxItem Content="顶部"/><ComboBoxItem Content="底部"/><ComboBoxItem Content="左侧"/><ComboBoxItem Content="右侧"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="翻页器位置"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding FlipperPosition}"><ComboBoxItem Content="居中"/><ComboBoxItem Content="底部"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="安全区域"><fa:FASettingsExpanderItem.Footer><NumericUpDown Width="110" Minimum="0" Maximum="50" Value="{Binding SafeArea}" FormatString="0"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="缩放比例"><fa:FASettingsExpanderItem.Footer><Slider Width="180" Minimum="0.5" Maximum="2" Value="{Binding OverlayScale}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="弹出窗口缩放"><fa:FASettingsExpanderItem.Footer><Slider Width="180" Minimum="0.5" Maximum="2" Value="{Binding PopWindowScale}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
    </fa:FASettingsExpander>
    <lumn:IconText Glyph="{lumn:Fi WrenchRegular}" Text="边缘与对齐" Margin="0,12,0,4"/>
    <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi WrenchRegular}}" Header="边缘与对齐">
      <fa:FASettingsExpanderItem Content="严格边缘对齐" Description="让 Overlay 边缘吸附到屏幕边缘。"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding StrictEdgeAlignment}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="工具栏自动半折" Description="鼠标离开工具栏后自动折叠为半宽状态。"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ToolbarAutoHalfCollapse}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
    </fa:FASettingsExpander>
    <lumn:IconText Glyph="{lumn:Fi SettingsRegular}" Text="高级" Margin="0,12,0,4"/>
    <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi SettingsRegular}}" Header="高级窗口行为">
      <fa:FASettingsExpanderItem Content="UI 访问置顶" Description="让 Overlay 在系统 UI 应用切换时始终保持在最上层。"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding UiAccessTopmost}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="允许录屏" Description="允许 Overlay 出现在录屏或截图画面中。"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding AllowRecording}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      <fa:FASettingsExpanderItem Content="置顶检查间隔"><fa:FASettingsExpanderItem.Footer><ComboBox Width="150" SelectedIndex="{Binding ZOrderCheckIntervalIndex}"><ComboBoxItem Content="100 ms"/><ComboBoxItem Content="200 ms"/><ComboBoxItem Content="500 ms"/><ComboBoxItem Content="1000 ms"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
    </fa:FASettingsExpander>
  </StackPanel></ScrollViewer>
</UserControl>
