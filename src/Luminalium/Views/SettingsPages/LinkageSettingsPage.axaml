<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.LinkageSettingsPage" x:DataType="cfg:MainConfigModel"><ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi ArrowSyncRegular}" Text="联动" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ArrowSyncRegular}}" Header="随机联动模式" Description="以随机顺序联动触发幻灯片翻页与 Overlay 动作，避免操作顺序过于固定。"><fa:FASettingsExpander.Footer><ToggleSwitch IsChecked="{Binding RandomLinkageEnabled}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander></StackPanel></ScrollViewer></UserControl>
