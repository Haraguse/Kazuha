<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:cfg="using:Luminalium.Models.Config" x:Class="Luminalium.Views.SettingsPages.PersonalizationSettingsPage" x:DataType="cfg:MainConfigModel">
 <ScrollViewer><StackPanel Classes="page-container animated-intro" Spacing="4"><lumn:IconText Glyph="{lumn:Fi PaintBrushRegular}" Text="外观" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi WeatherMoonRegular}}" Header="外观模式" Description="调整应用程序的显示主题。"><fa:FASettingsExpander.Footer><ComboBox Width="150" SelectedIndex="{Binding ThemeIndex}"><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/><ComboBoxItem Content="跟随系统"/></ComboBox></fa:FASettingsExpander.Footer></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi PaintBrushRegular}}" Header="配色方案" Description="选择配色方案，影响设置页与工具栏外观。"><fa:FASettingsExpander.Footer><TextBox Width="150" Text="{Binding AccentColor}"/></fa:FASettingsExpander.Footer></fa:FASettingsExpander><Separator Margin="0,12,0,4"/><lumn:IconText Glyph="{lumn:Fi ImageRegular}" Text="启动画面" Margin="0,0,0,4"/><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ImageRegular}}" Header="显示启动画面" Description="控制启动画面的显示时机。"><fa:FASettingsExpander.Footer><ComboBox Width="180" SelectedIndex="{Binding SplashMode}"><ComboBoxItem Content="每次都显示"/><ComboBoxItem Content="从不显示"/><ComboBoxItem Content="开机自启时隐藏"/><ComboBoxItem Content="指定时段隐藏"/></ComboBox></fa:FASettingsExpander.Footer><fa:FASettingsExpanderItem Content="显示详细状态信息" Description="在启动画面显示字体、插件等详细加载进度文本"><fa:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowDetailedSplash}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem><fa:FASettingsExpanderItem Content="启动画面样式"><fa:FASettingsExpanderItem.Footer><ComboBox Width="180" SelectedIndex="{Binding SplashStyle}"><ComboBoxItem Content="默认"/><ComboBoxItem Content="Momokan"/><ComboBoxItem Content="nina_iseri_1_2"/></ComboBox></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem></fa:FASettingsExpander><fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi WindowMultipleRegular}}" Header="Overlay 主题" Description="自定义 Overlay 的 HTML/CSS/JS 主题。"><fa:FASettingsExpander.Footer><ComboBox Width="180" SelectedIndex="{Binding OverlayTheme}"><ComboBoxItem Content="默认主题"/></ComboBox></fa:FASettingsExpander.Footer></fa:FASettingsExpander></StackPanel></ScrollViewer>
</UserControl>
