<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" xmlns:lumn="http://luminalium.sectl.cn/schemas/xaml/core" xmlns:vm="using:Luminalium.Views.SettingsPages" x:Class="Luminalium.Views.SettingsPages.StorageSettingsPage" x:DataType="vm:StorageSettingsPageViewModel">
  <ScrollViewer>
    <StackPanel Classes="page-container animated-intro" Spacing="4">
      <lumn:IconText Glyph="{lumn:Fi FolderOpenRegular}" Text="配置文件" Margin="0,0,0,4"/>
      <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi FolderOpenRegular}}" Header="配置文件位置" Description="{Binding SaveDescription}">
        <fa:FASettingsExpanderItem Content="配置文件"><fa:FASettingsExpanderItem.Footer><TextBlock Text="{Binding ConfigFilePath}" MaxWidth="480" TextWrapping="Wrap" Opacity="0.7"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="配置目录"><fa:FASettingsExpanderItem.Footer><TextBlock Text="{Binding ConfigDirectoryPath}" MaxWidth="480" TextWrapping="Wrap" Opacity="0.7"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      </fa:FASettingsExpander>
      <lumn:IconText Glyph="{lumn:Fi ArrowSyncRegular}" Text="配置操作" Margin="0,12,0,4"/>
      <fa:FASettingsExpander IconSource="{lumn:FluentIconSource {lumn:Fi ArrowSyncRegular}}" Header="配置操作" Description="重新读取或删除当前新壳配置。">
        <fa:FASettingsExpanderItem Content="打开配置目录"><fa:FASettingsExpanderItem.Footer><Button Content="打开" Command="{Binding OpenDirectoryCommand}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="重新加载配置"><fa:FASettingsExpanderItem.Footer><Button Content="重新加载" Command="{Binding ReloadCommand}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Content="删除配置文件" Description="删除后会使用默认配置重新创建。"><fa:FASettingsExpanderItem.Footer><Button Content="删除并恢复默认" Command="{Binding DeleteCommand}"/></fa:FASettingsExpanderItem.Footer></fa:FASettingsExpanderItem>
      </fa:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
