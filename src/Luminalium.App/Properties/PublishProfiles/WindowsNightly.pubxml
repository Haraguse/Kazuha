<?xml version="1.0" encoding="utf-8"?>
<!--
  WindowsNightly publish profile for Luminalium.App (Task 5 nightly contract).

  Contract:
  - Release, win-x64, self-contained: .NET runtime bundled, no framework dependency.
  - Directory-based output (PublishSingleFile=false): Avalonia native libraries
    (e.g. libSkiaSharp.dll, Avalonia.Native.dll) remain as files on disk.
  - PublishReadyToRun=false: JIT-compiled output, no ReadyToRun images.
  - No debug symbols: DebugType=none / DebugSymbols=false (Release alone still
    emits portable .pdb by default, so these are pinned explicitly).
  - TargetFramework mirrors the project Windows floor net10.0-windows10.0.17763.0;
    the project's TargetPlatformMinVersion is untouched.

  Invoke WITHOUT the no-build flag so XAML / compiled bindings are regenerated:
    dotnet publish Luminalium.App.csproj -p:PublishProfile=WindowsNightly
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\Release\net10.0-windows10.0.17763.0\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    DebugType/DebugSymbols above are project-scoped, so referenced projects still
    emit portable .pdb files, and SkiaSharp/HarfBuzz native packages ship .pdb
    assets. Strip every .pdb from the publish output so the nightly bundle is
    symbol-free regardless of where a symbol file came from.
  -->
  <Target Name="StripDebugSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PdbInPublishDir Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Message Importance="high" Text="Removing @(_PdbInPublishDir->Count()) debug symbol file(s) from publish output." />
    <Delete Files="@(_PdbInPublishDir)" />
  </Target>
</Project>
