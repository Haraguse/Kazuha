<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="using:FluentAvalonia.UI.Controls"
                       xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                       xmlns:vm="using:Luminalium.App.ViewModels"
                       x:Class="Luminalium.App.Views.MainWindow"
                       x:DataType="vm:ShellViewModel"
                       Title="Luminalium"
                       Width="{StaticResource ShellWindowWidth}"
                       Height="{StaticResource ShellWindowHeight}"
                       MinWidth="{StaticResource ShellWindowMinWidth}"
                       MinHeight="{StaticResource ShellWindowMinHeight}"
                       WindowStartupLocation="CenterScreen"
                       AutomationProperties.Name="Luminalium main window">
    <Grid RowDefinitions="Auto,*" KeyboardNavigation.TabNavigation="Cycle">
        <Border Grid.Row="0"
                Height="{StaticResource ShellTitleBarHeight}"
                Padding="{StaticResource ShellTitleBarPadding}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*">
                <Image x:Name="TitleIcon"
                       Width="{StaticResource ShellTitleIconSize}"
                       Height="{StaticResource ShellTitleIconSize}"
                       Source="/Assets/logo.ico"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Luminalium icon" />
                <TextBlock Grid.Column="1"
                           Margin="{StaticResource ShellInlineStartMargin}"
                           Text="Luminalium"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ui:FANavigationView x:Name="ShellNavigation"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsPaneToggleButtonVisible="False"
                             IsSettingsVisible="False"
                              IsBackButtonVisible="True"
                              IsBackEnabled="{Binding CanGoBack}"
                              BackRequested="OnBackRequested"
                              ItemInvoked="OnItemInvoked"
                              SelectionChanged="OnSelectionChanged"
                              AutomationProperties.Name="Luminalium navigation"
                             AutomationProperties.AutomationId="LuminaliumNavigation">
            <Grid RowDefinitions="*,Auto">
                <ui:FAFrame x:Name="ShellFrame"
                            Grid.Row="0"
                            IsNavigationStackEnabled="False"
                            AutomationProperties.Name="Luminalium page frame"
                            AutomationProperties.AutomationId="LuminaliumFrame" />

                <Border Grid.Row="1"
                        Padding="{StaticResource ShellCompactPadding}"
                        BorderThickness="{StaticResource ShellFooterBorderThickness}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                        <Button MinHeight="{StaticResource OverlayTouchTargetSize}"
                                Click="OnOpenOverlayClicked"
                                Content="Open overlay"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="OpenOverlay"
                                AutomationProperties.HelpText="Open the presentation overlay" />
                        <TextBlock Text="{Binding VersionDisplay}"
                                   FontSize="{StaticResource ShellCaptionFontSize}"
                                   Opacity="{StaticResource ShellMutedOpacity}"
                                   AutomationProperties.Name="Luminalium version" />
                        <TextBlock Text="{Binding TrayStatusText}"
                                   FontSize="{StaticResource ShellCaptionFontSize}"
                                   Opacity="{StaticResource ShellMutedOpacity}"
                                   AutomationProperties.Name="Tray status" />
                        <TextBlock Text="{Binding ErrorText}"
                                   FontSize="{StaticResource ShellCaptionFontSize}"
                                   Opacity="{StaticResource ShellErrorOpacity}"
                                   IsVisible="{Binding HasError}"
                                   AutomationProperties.Name="Shell error" />
                    </StackPanel>
                </Border>
            </Grid>
        </ui:FANavigationView>
    </Grid>
</windowing:FAAppWindow>
