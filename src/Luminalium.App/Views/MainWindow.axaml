<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                       xmlns:vm="using:Luminalium.App.ViewModels"
                       x:Class="Luminalium.App.Views.MainWindow"
                       x:DataType="vm:ShellViewModel"
                       Title="Luminalium"
                       Width="{StaticResource ShellWindowWidth}"
                       Height="{StaticResource ShellWindowHeight}"
                       MinWidth="{StaticResource ShellWindowMinWidth}"
                       MinHeight="{StaticResource ShellWindowMinHeight}"
                       WindowStartupLocation="CenterScreen"
                       AutomationProperties.Name="Luminalium main window">
    <Grid RowDefinitions="Auto,*" KeyboardNavigation.TabNavigation="Cycle">
        <Border Grid.Row="0"
                Height="{StaticResource ShellTitleBarHeight}"
                Padding="{StaticResource ShellTitleBarPadding}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*">
                <Image x:Name="TitleIcon"
                       Width="{StaticResource ShellTitleIconSize}"
                       Height="{StaticResource ShellTitleIconSize}"
                       Source="/Assets/logo.ico"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Luminalium icon" />
                <TextBlock Grid.Column="1"
                           Margin="{StaticResource ShellInlineStartMargin}"
                           Text="Luminalium"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="{StaticResource ShellPageMargin}"
                        Spacing="{StaticResource ShellPageSpacing}"
                        MaxWidth="{StaticResource ShellPageMaxWidth}"
                        HorizontalAlignment="Left">
                <StackPanel Spacing="{StaticResource ShellTitleStackSpacing}">
                    <TextBlock Text="{Binding ProductName}"
                               FontSize="{StaticResource ShellTitleFontSize}"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="Luminalium product name" />
                    <TextBlock Text="{Binding VersionDisplay}"
                               FontSize="{StaticResource ShellSubtitleFontSize}"
                               Opacity="{StaticResource ShellMutedOpacity}"
                               AutomationProperties.Name="Luminalium version line" />
                </StackPanel>

                <Border Padding="{StaticResource ShellSectionPadding}"
                        CornerRadius="{StaticResource ShellCornerRadius}"
                        BorderThickness="{StaticResource ShellBorderThickness}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="{StaticResource ShellSectionSpacing}">
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                                Command="{Binding NavigateToSettingsCommand}"
                                Content="{Binding Settings.Title}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="OpenSettings" />
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                                Click="OnOpenOverlayClicked"
                                Content="{Binding OpenOverlayText}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="OpenOverlay"
                                AutomationProperties.HelpText="{Binding OpenOverlayHelpText}" />
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                                Click="OnOpenLogsClicked"
                                Content="{Binding Logs.Title}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="OpenLogs" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TrayStatusText}"
                           FontSize="{StaticResource ShellCaptionFontSize}"
                           Opacity="{StaticResource ShellMutedOpacity}"
                           AutomationProperties.Name="Tray status" />
                <TextBlock Text="{Binding ErrorText}"
                           FontSize="{StaticResource ShellCaptionFontSize}"
                           Opacity="{StaticResource ShellErrorOpacity}"
                           IsVisible="{Binding HasError}"
                           AutomationProperties.Name="Shell error" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</windowing:FAAppWindow>
