<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luminalium.App.ViewModels"
             x:Class="Luminalium.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource ShellPageMargin}" Spacing="{StaticResource ShellPageSpacing}" MaxWidth="{StaticResource ShellSettingsMaxWidth}" HorizontalAlignment="Left">
            <StackPanel Spacing="{StaticResource ShellTitleStackSpacing}">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource ShellTitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionDisplay}"
                           FontSize="{StaticResource ShellSubtitleFontSize}"
                           Opacity="{StaticResource ShellMutedOpacity}" />
            </StackPanel>

            <Border Padding="{StaticResource ShellSectionPadding}"
                    CornerRadius="{StaticResource ShellCornerRadius}"
                    BorderThickness="{StaticResource ShellBorderThickness}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource ShellSettingsRowSpacing}" ColumnSpacing="{StaticResource ShellSettingsColumnSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ShellSettingsControlColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding ThemeModeLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ThemeModeDescription}"
                                   TextWrapping="Wrap"
                                   Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                               ItemsSource="{Binding ThemeModeOptions}"
                               SelectedItem="{Binding SelectedThemeModeOption, Mode=TwoWay}"
                               AutomationProperties.Name="{Binding ThemeModeLabel}"
                               AutomationProperties.HelpText="{Binding ThemeModeHelpText}" />

                    <StackPanel Grid.Row="1" Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding AccentColorLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AccentColorDescription}"
                                   TextWrapping="Wrap"
                                   Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                              ItemsSource="{Binding AccentOptions}"
                              SelectedItem="{Binding SelectedAccentOption, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding AccentColorLabel}"
                              AutomationProperties.HelpText="{Binding AccentColorHelpText}" />

                    <StackPanel Grid.Row="2" Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LanguageDescription}"
                                   TextWrapping="Wrap"
                                   Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding LanguageLabel}"
                               AutomationProperties.HelpText="{Binding LanguageHelpText}" />

                    <StackPanel Grid.Row="3" Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding FontFamilyLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FontFamilyDescription}" TextWrapping="Wrap" Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                              ItemsSource="{Binding FontFamilyOptions}"
                              SelectedItem="{Binding SelectedFontFamilyOption, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding FontFamilyLabel}"
                              AutomationProperties.HelpText="{Binding FontFamilyHelpText}" />
                </Grid>
            </Border>

            <Border Padding="{StaticResource ShellSectionPadding}"
                    CornerRadius="{StaticResource ShellCornerRadius}"
                    BorderThickness="{StaticResource ShellBorderThickness}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="{StaticResource ShellSectionSpacing}">
                    <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding SplashTitle}" FontSize="{StaticResource ShellSectionTitleFontSize}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SplashDescription}" TextWrapping="Wrap" Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource ShellSettingsColumnSpacing}" RowSpacing="{StaticResource ShellSettingsRowSpacing}">
                        <TextBlock Text="{Binding SplashModeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                                  ItemsSource="{Binding SplashModeOptions}"
                                  SelectedItem="{Binding SelectedSplashModeOption, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding SplashModeLabel}"
                                  AutomationProperties.HelpText="{Binding SplashModeHelpText}" />
                        <TextBlock Grid.Row="1" Text="{Binding SplashStyleLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                                  ItemsSource="{Binding SplashStyleOptions}"
                                  SelectedItem="{Binding SelectedSplashStyleOption, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding SplashStyleLabel}"
                                  AutomationProperties.HelpText="{Binding SplashStyleHelpText}" />
                        <TextBlock Grid.Row="2" Text="{Binding SplashDetailedLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowDetailedSplash, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource ShellSettingsColumnSpacing}">
                        <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                            <TextBlock Text="{Binding SplashStartTimeLabel}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SplashStartTime, Mode=TwoWay}" MinHeight="{StaticResource ShellTouchTargetMinHeight}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource ShellCompactSpacing}">
                            <TextBlock Text="{Binding SplashEndTimeLabel}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SplashEndTime, Mode=TwoWay}" MinHeight="{StaticResource ShellTouchTargetMinHeight}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="{StaticResource ShellSectionPadding}"
                    CornerRadius="{StaticResource ShellCornerRadius}"
                    BorderThickness="{StaticResource ShellBorderThickness}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource ShellIdentityRowSpacing}" ColumnSpacing="{StaticResource ShellIdentityColumnSpacing}">
                    <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding PasswordProtectionTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PasswordProtectionDescription}" TextWrapping="Wrap" Opacity="{StaticResource ShellMutedOpacity}" />
                        <TextBlock Text="{Binding PasswordProtectionStatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource ShellCompactSpacing}">
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}" Command="{Binding EnablePasswordProtectionCommand}" Content="{Binding EnablePasswordProtectionText}" />
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}" Command="{Binding ChangePasswordCommand}" Content="{Binding ChangePasswordText}" />
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}" Command="{Binding DisablePasswordProtectionCommand}" Content="{Binding DisablePasswordProtectionText}" />
                        <Button MinHeight="{StaticResource ShellTouchTargetMinHeight}" Command="{Binding UnlockSettingsCommand}" Content="{Binding UnlockSettingsText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="{StaticResource ShellSectionPadding}"
                    CornerRadius="{StaticResource ShellCornerRadius}"
                    BorderThickness="{StaticResource ShellBorderThickness}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource ShellIdentityRowSpacing}" ColumnSpacing="{StaticResource ShellIdentityColumnSpacing}">
                    <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding UpdatesTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   TextWrapping="Wrap"
                                   Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="{Binding CheckForUpdatesText}"
                            AutomationProperties.Name="{Binding CheckForUpdatesText}"
                            AutomationProperties.HelpText="{Binding CheckForUpdatesHelpText}" />
                </Grid>
            </Border>

            <Border Padding="{StaticResource ShellSectionPadding}"
                    CornerRadius="{StaticResource ShellCornerRadius}"
                    BorderThickness="{StaticResource ShellBorderThickness}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource ShellIdentityRowSpacing}" ColumnSpacing="{StaticResource ShellIdentityColumnSpacing}">
                    <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
                        <TextBlock Text="{Binding ApplicationIdentityTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AppUserModelId}" Opacity="{StaticResource ShellMutedOpacity}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinHeight="{StaticResource ShellTouchTargetMinHeight}"
                            Command="{Binding ShowAboutCommand}"
                            Content="{Binding AboutText}"
                            AutomationProperties.Name="{Binding AboutName}"
                            AutomationProperties.HelpText="{Binding AboutHelpText}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
