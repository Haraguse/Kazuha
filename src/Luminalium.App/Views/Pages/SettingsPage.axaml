<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luminalium.App.ViewModels"
             xmlns:pages="using:Luminalium.App.Views.Pages"
             x:Class="Luminalium.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <Grid ColumnDefinitions="280,*">
        <!-- Left settings category pane -->
        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid RowDefinitions="Auto,*">
                <TextBox Grid.Row="0"
                         Margin="16,52,16,12"
                         PlaceholderText="搜索设置..."
                         MinHeight="{StaticResource ShellTouchTargetMinHeight}" />

                <ListBox Grid.Row="1"
                         Margin="8,0,8,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Categories}"
                         SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:SettingsCategory">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="14,9" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right content area -->
        <Border Grid.Column="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Padding="36,52,44,0">
            <ContentControl Content="{Binding CurrentCategoryViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:GeneralSettingsViewModel">
                        <pages:GeneralSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PersonalizationSettingsViewModel">
                        <pages:PersonalizationSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ToolbarSettingsViewModel">
                        <pages:ToolbarSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:FontSettingsViewModel">
                        <pages:FontSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LinkageSettingsViewModel">
                        <pages:LinkageSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BuiltInSettingsViewModel">
                        <pages:BuiltInSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:PenSettingsViewModel">
                        <pages:PenSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:WindowSettingsViewModel">
                        <pages:WindowSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:StatusBarSettingsViewModel">
                        <pages:StatusBarSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:StorageSettingsViewModel">
                        <pages:StorageSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:NotificationSettingsViewModel">
                        <pages:NotificationSettingsPage />
                    </DataTemplate>
                    <DataTemplate DataType="vm:AboutSettingsViewModel">
                        <pages:AboutSettingsPage />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
