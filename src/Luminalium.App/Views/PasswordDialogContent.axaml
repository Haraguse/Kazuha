<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luminalium.App.ViewModels"
             x:Class="Luminalium.App.Views.PasswordDialogContent"
             x:DataType="vm:PasswordDialogViewModel">
    <StackPanel Width="420" Spacing="{StaticResource ShellIdentityRowSpacing}">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
        <StackPanel Spacing="{StaticResource ShellCompactSpacing}">
            <TextBlock Text="{Binding PasswordLabel}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" />
        </StackPanel>
        <StackPanel Spacing="{StaticResource ShellCompactSpacing}" IsVisible="{Binding RequiresConfirmation}">
            <TextBlock Text="{Binding ConfirmationLabel}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Confirmation, Mode=TwoWay}" PasswordChar="*" />
        </StackPanel>
    </StackPanel>
</UserControl>
