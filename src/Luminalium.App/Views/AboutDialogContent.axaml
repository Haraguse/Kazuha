<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luminalium.App.ViewModels"
             x:Class="Luminalium.App.Views.AboutDialogContent"
             x:DataType="vm:AboutDialogViewModel">
    <StackPanel Spacing="{StaticResource ShellIdentityRowSpacing}">
        <TextBlock Text="{Binding ProductName}"
                   FontSize="{StaticResource ShellSectionTitleFontSize}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding VersionDisplay}" />
        <TextBlock Text="{Binding AppUserModelId}"
                   Opacity="{StaticResource ShellMutedOpacity}" />
    </StackPanel>
</UserControl>
