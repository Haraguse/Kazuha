<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:overlay="using:Luminalium.App.Overlay"
                        xmlns:vm="using:Luminalium.App.ViewModels"
                        xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
                        x:Class="Luminalium.App.Views.BoardWindow"
                        x:DataType="vm:BoardViewModel"
                        Title="{Binding WindowTitle}"
                        Width="900" Height="600"
                        MinWidth="640" MinHeight="480"
                        WindowStartupLocation="CenterScreen"
                        AutomationProperties.Name="BoardWindow">
    <Grid RowDefinitions="Auto,Auto,*" KeyboardNavigation.TabNavigation="Cycle">
        <!-- Custom title bar content; system caption buttons are rendered by FAAppWindow. -->
        <Border Grid.Row="0"
                Height="{StaticResource ShellTitleBarHeight}"
                Padding="{StaticResource ShellTitleBarPadding}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                AutomationProperties.Name="Board title bar">
            <Grid ColumnDefinitions="Auto,*">
                <Image Width="{StaticResource ShellTitleIconSize}"
                       Height="{StaticResource ShellTitleIconSize}"
                       Source="/Assets/logo.ico"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Luminalium icon" />
                <TextBlock Grid.Column="1"
                           Margin="{StaticResource ShellInlineStartMargin}"
                           Text="{Binding WindowTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Command="{Binding SelectRedColorCommand}"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Red]}">
                        <PathIcon Data="M12,12 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
                                  Foreground="Red" />
                    </Button>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Command="{Binding ToggleEraserCommand}"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Eraser]}">
                        <PathIcon Data="M15,3 L21,9 L9,21 L3,15 Z" />
                    </Button>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Command="{Binding ClearBoardCommand}"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Clear]}">
                        <PathIcon Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z" />
                    </Button>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Click="OnSaveClicked"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Save]}">
                        <PathIcon Data="M17,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L7,19 L7,17 L19,17 L19,5 L17,3 Z M12,19 C10.9,19 10,18.1 10,17 C10,15.9 10.9,15 12,15 C13.1,15 14,15.9 14,17 C14,18.1 13.1,19 12,19 Z" />
                    </Button>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Click="OnCloseClicked"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Close]}">
                        <PathIcon Data="M6,6 L18,18 M18,6 L6,18" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               AutomationProperties.Name="BoardStatus" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding StrokeCountText}"
                               AutomationProperties.Name="BoardStrokeCount" />
                </StackPanel>
            </Grid>
        </Border>

        <overlay:AnnotationCanvas Grid.Row="2"
                                  x:Name="BoardCanvas"
                                  CanDraw="True"
                                  StrokeColor="{Binding StrokeColor}"
                                  StrokeWidth="{Binding StrokeWidth}"
                                  Strokes="{Binding Document.Strokes}"
                                  AutomationProperties.Name="BoardCanvas" />
    </Grid>
</windowing:FAAppWindow>
