<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:overlay="using:Luminalium.App.Overlay"
                        xmlns:ui="using:FluentAvalonia.UI.Controls"
                        xmlns:vm="using:Luminalium.App.ViewModels"
                        xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                        xmlns:inking="using:DotNetCampus.Inking"
                        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
                        x:Class="Luminalium.App.Views.BoardWindow"
                        x:DataType="vm:BoardViewModel"
                        Title="{Binding WindowTitle}"
                        Width="900" Height="600"
                        MinWidth="640" MinHeight="480"
                        WindowStartupLocation="CenterScreen"
                        AutomationProperties.Name="BoardWindow">
    <Grid RowDefinitions="Auto,Auto,*" KeyboardNavigation.TabNavigation="Cycle">
        <!-- Custom title bar content; system caption buttons are rendered by FAAppWindow. -->
        <Border Grid.Row="0"
                Height="{StaticResource ShellTitleBarHeight}"
                Padding="{StaticResource ShellTitleBarPadding}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                AutomationProperties.Name="Board title bar">
            <Grid ColumnDefinitions="Auto,*">
                <Image Width="{StaticResource ShellTitleIconSize}"
                       Height="{StaticResource ShellTitleIconSize}"
                       Source="/Assets/logo.ico"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Luminalium icon" />
                <TextBlock Grid.Column="1"
                           Margin="{StaticResource ShellInlineStartMargin}"
                           Text="{Binding WindowTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <ToggleButton x:Name="PenButton"
                                  MinHeight="40" MinWidth="40"
                                  Padding="8"
                                  IsChecked="{Binding IsPenActive}"
                                  Command="{Binding ActivatePenCommand}"
                                  DoubleTapped="OnPenDoubleTapped"
                                  AutomationProperties.Name="{Binding Localization[Board.Toolbar.Pen]}">
                        <ui:FASymbolIcon Symbol="Edit" FontSize="20" />
                        <ToggleButton.Flyout>
                            <Flyout Placement="Bottom">
                                <ItemsControl ItemsSource="{Binding StrokeColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="30" Height="30"
                                                    Margin="4" CornerRadius="15"
                                                    Command="{Binding $parent[ItemsControl].DataContext.SelectColorCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Border Width="30" Height="30" CornerRadius="15"
                                                        BorderThickness="2"
                                                        BorderBrush="{Binding SelectionBrush}">
                                                    <Ellipse Width="24" Height="24" Fill="{Binding Brush}" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </ToggleButton.Flyout>
                    </ToggleButton>
                    <ToggleButton MinHeight="40" MinWidth="40"
                                  Padding="8"
                                  IsChecked="{Binding IsEraser}"
                                  Command="{Binding ActivateEraserCommand}"
                                  AutomationProperties.Name="{Binding Localization[Board.Toolbar.Eraser]}">
                        <PathIcon Data="M15.8697,2.66878 L20.8382,7.6373 C21.7169,8.51598 21.7169,9.9406 20.8382,10.8193 L12.1564,19.4998 L18.2543,19.5 C18.634,19.5 18.9478,19.7821 18.9975,20.1482 L19.0043,20.25 C19.0043,20.6297 18.7222,20.9435 18.3561,20.9931 L18.2543,21 L9.84431,21.0012 C9.2281,21.0348 8.6007,20.8163 8.12998,20.3456 L3.16145,15.377 C2.28277,14.4984 2.28277,13.0737 3.16145,12.1951 L12.6877,2.66878 C13.5664,1.7901 14.991,1.7901 15.8697,2.66878 Z M5.70844,11.7678 L4.22211,13.2557 C3.92922,13.5486 3.92922,14.0235 4.22211,14.3164 L9.19064,19.2849 C9.33708,19.4314 9.52903,19.5046 9.72097,19.5046 L9.74985,19.5 L9.78834,19.5016 C9.95725,19.4864 10.122,19.4142 10.2513,19.2849 L11.7374,17.7978 L5.70844,11.7678 Z M13.7484,3.72944 L6.76944,10.7068 L12.7984,16.7368 L19.7776,9.75862 C20.0705,9.46573 20.0705,8.99085 19.7776,8.69796 L14.8091,3.72944 C14.5162,3.43654 14.0413,3.43654 13.7484,3.72944 Z" />
                    </ToggleButton>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Command="{Binding ClearBoardCommand}"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Clear]}">
                        <ui:FASymbolIcon Symbol="Delete" FontSize="20" />
                    </Button>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Click="OnSaveClicked"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Save]}">
                        <ui:FASymbolIcon Symbol="Save" FontSize="20" />
                    </Button>
                    <Button MinHeight="40" MinWidth="40"
                            Padding="8"
                            Click="OnCloseClicked"
                            AutomationProperties.Name="{Binding Localization[Board.Toolbar.Close]}">
                        <ui:FASymbolIcon Symbol="Dismiss" FontSize="20" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               AutomationProperties.Name="BoardStatus" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding StrokeCountText}"
                               AutomationProperties.Name="BoardStrokeCount" />
                </StackPanel>
            </Grid>
        </Border>

        <inking:InkCanvas Grid.Row="2"
                          x:Name="BoardCanvas"
                          AutomationProperties.Name="BoardCanvas" />
    </Grid>
</windowing:FAAppWindow>
