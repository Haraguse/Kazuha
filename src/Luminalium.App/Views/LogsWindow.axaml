<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                       xmlns:pages="using:Luminalium.App.Views.Pages"
                       xmlns:vm="using:Luminalium.App.ViewModels"
                       x:Class="Luminalium.App.Views.LogsWindow"
                       x:DataType="vm:LogsViewModel"
                       Title="{Binding Title}"
                       Width="980"
                       Height="720"
                       MinWidth="760"
                       MinHeight="560"
                       WindowStartupLocation="CenterOwner">
    <pages:LogsPage DataContext="{Binding}" />
</windowing:FAAppWindow>
