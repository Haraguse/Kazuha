<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Luminalium.App: Avalonia desktop application shell (Issue #96 alignment).
    Cross-platform plain net10.0: the UI and view models use only Avalonia /
    FluentAvalonia / Core / Plugins / Updater types. Windows-specific behavior
    lives in Luminalium.Platform.Windows behind Core contracts and is never
    referenced here. The app.manifest carries the Windows 10 1809+ declaration
    and is ignored on other platforms.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Luminalium</AssemblyName>
    <RootNamespace>Luminalium.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 12 line, pinned to 12.1.1. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <!-- FA pulls these two transitively; pinning keeps one Avalonia version in the graph. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- FluentAvaloniaUI 3.x on net10.0. -->
    <PackageReference Include="FluentAvaloniaUI" />
    <!-- MVVM toolkit validated alongside the UI stack. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luminalium.Core\Luminalium.Core.csproj" />
    <ProjectReference Include="..\Luminalium.Plugins\Luminalium.Plugins.csproj" />
    <ProjectReference Include="..\Luminalium.Theming\Luminalium.Theming.csproj" />
    <ProjectReference Include="..\Luminalium.Updater\Luminalium.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />

    <Content Include="..\..\version.json" Link="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyOptionalWindowsThemingProvider" AfterTargets="Build;Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <WindowsThemingProviderPath>$(MSBuildThisFileDirectory)..\Luminalium.Platform.Windows\bin\$(Configuration)\net10.0-windows10.0.17763.0\Luminalium.Platform.Windows.dll</WindowsThemingProviderPath>
      <WindowsThemingProviderDestination Condition="'$(PublishDir)' != ''">$(PublishDir)</WindowsThemingProviderDestination>
      <WindowsThemingProviderDestination Condition="'$(WindowsThemingProviderDestination)' == ''">$(OutputPath)</WindowsThemingProviderDestination>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Luminalium.Platform.Windows\Luminalium.Platform.Windows.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=" />
    <Copy SourceFiles="$(WindowsThemingProviderPath)"
          DestinationFolder="$(WindowsThemingProviderDestination)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(WindowsThemingProviderPath)')" />
  </Target>

</Project>
