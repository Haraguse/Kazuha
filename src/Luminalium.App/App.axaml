<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Luminalium.App.App">
    <Application.Styles>
        <!-- Exactly one theme: FluentAvaloniaTheme. No Avalonia FluentTheme is registered.
             PreferSystemTheme + PreferUserAccentColor mirrors Luminalium's
             Monet/system-accent theming intent (Task 2 validated pattern). -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
    </Application.Styles>
</Application>
