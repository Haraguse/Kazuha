<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows-only manifest. Keep it minimal: Avalonia's Win32 backend sets
       per-monitor v2 DPI awareness at startup, so no dpiAware section is declared. -->
  <assemblyIdentity version="1.0.0.0" name="Luminalium" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 (covers 1809+ and Windows 11) -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
