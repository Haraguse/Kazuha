{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/messageBase"
    },
    {
      "properties": {
        "message_type": {
          "const": "error"
        },
        "payload": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "common.schema.json#/$defs/errorCode"
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
