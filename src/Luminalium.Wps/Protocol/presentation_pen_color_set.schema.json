{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/messageBase"
    },
    {
      "properties": {
        "message_type": {
          "type": "string",
          "const": "presentation_pen_color_set"
        },
        "payload": {
          "type": "object",
          "properties": {
            "color": {
              "$ref": "common.schema.json#/$defs/colorHex"
            }
          },
          "required": [
            "color"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "message_type",
        "payload"
      ]
    }
  ],
  "unevaluatedProperties": false
}
