{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/messageBase"
    },
    {
      "properties": {
        "message_type": {
          "const": "command_result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "command_id": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "code": {
              "$ref": "common.schema.json#/$defs/resultCode"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "command_id",
            "ok",
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "message_type",
        "payload"
      ]
    }
  ],
  "unevaluatedProperties": false
}
