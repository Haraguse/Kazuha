{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/messageBase"
    },
    {
      "properties": {
        "message_type": {
          "type": "string",
          "const": "presentation_thumbnails"
        },
        "payload": {
          "type": "object",
          "properties": {
            "document_revision": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/thumbnailItem"
              }
            }
          },
          "required": [
            "items"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
