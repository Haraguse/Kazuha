{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/messageBase"
    },
    {
      "properties": {
        "message_type": {
          "const": "presentation_state"
        },
        "payload": {
          "type": "object",
          "properties": {
            "document": {
              "$ref": "common.schema.json#/$defs/documentInfo"
            },
            "presentation": {
              "$ref": "common.schema.json#/$defs/presentationState"
            }
          },
          "required": [
            "document",
            "presentation"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
