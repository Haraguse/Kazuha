<Project>

  <!--
    Luminalium C# migration - Task 3: solution-wide build governance.
    Applies to every project under the repository root, including the
    pre-existing ../scripts/smtc_helper helper (which keeps its own TFM).
    Per-project TFMs stay in each .csproj; do not centralize them here.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- .NET SDK built-in analyzers, latest level. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

</Project>
